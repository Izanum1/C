#include <stdio.h>

int main(){
    
    int n [6], i;
    
    // Preenchendo o vetor
    printf("Digite 6 valores inteiros:\n");
    for(i = 0; i < 6; i++){
        printf("Posicao %d: \n", i);
        scanf("%d", &n[i]);
    }
    
    
    // Imprimindo na ordem inversa
    printf("Numeros na ordem inversa:\n");
    for(i = 5; i >= 0; i--){
        printf("%d\n", n[i]);
    }
    return 0;
}