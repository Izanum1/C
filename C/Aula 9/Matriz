// Faca um programa que leia uma matriz 4x4.
// O programa deve perguntar o valor de cada posicao da matriz,
// em seguida imprima esta matriz na tela.
#include <stdio.h>
#define LIM 4

int main() {
    int n [LIM][LIM], i,j;
    
    for(i = 0; i < LIM; i++){
        for(j =0; j < LIM; j++){
            printf("Digite o valor da posicao (%d,%d): ",i,j);
            scanf("%d", &n[i][j]);
        }
    }
    for(i = 0; i < LIM; i++){
        for(j = 0; j < LIM; j++){
            printf("%d ", n[i][j]);
            printf("\n");
        }
    }
    return 0;
}