// Crie um código que pede um número ao usuário e imprime a tabuada desse número (de 1 a 10) utilizando a estrutura for
// que é ideal quando sabemos exatamente quantas vezes o laço deve rodar.

#include <stdio.h>
#include <stdlib.h>
int main (){
    int num, tab;
    
    printf("Digite o número para gerar sua tabuada: ");
    scanf("%d", &num);
    
    for (tab = 1; tab <= 10; tab++){
        printf("%d x %d = %d\n", num, tab, num * tab);
    }
    return 0;
}