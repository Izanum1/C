// Crie um programa que receba a nota de um aluno (de 0 a 10) e classifique o conceito segunda a regra:
// Nota maior ou igual a 7: "Aprovado"
// Nota entre 5 e 6.9: "Recuperação"
// Nota menor que 5: "Reprovado"

#include <stdio.h>
#include <stdlib.h>
int main (){
    float nota;
    
    printf("Digite a nota de seu aluno (0 a 10): ");
    scanf("%f", &nota);
    
    if(nota >= 7){
        printf("Resultado: Aprovado");
    } else if (nota >= 5){
        printf("Resultado: Recuperação");
    } else
        printf("Resultado: Reprovado");
    return 0;
}