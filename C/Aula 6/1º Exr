// Criar um programa que leia dois números inteiros do usuário, calcule a soma, a multiplicação e o resto da divisão entre eles, e exiba os resultados na tela.

#include <stdio.h>
#include <stdlib.h>

int main(){
    int n1,n2,s, m, r;
    
    scanf("%d %d", &n1, &n2);
    
    s = n1 + n2;
    m = n1 * n2;
    r = n1 % n2;
    
    printf("Soma: %d\n", s);
    printf("Multiplicação: %d\n", m);
    printf("Resto da divisão: %d\n", r);
    
    return 0;
}