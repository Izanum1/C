//Crie um programa que receba um número inteiro do usuário. O programa deve verificar e informar se o número digitado é "Par" ou "Impar".
//Utilizar o operador de resto da divisão %. Se o resto da divisão do número por 2 for igual a zero (==0), o número é par; caso contrário, é impar;

#include <stdio.h>
#include <stdlib.h>
int main(){
    int num;
    scanf("%d", &num);
    if(num % 2 == 0){
        printf("O número %d é par", num);
    }else printf("O número %d é impar", num);
    
    return 0;
}